---
// Each article's own address, /writing/<address>/, named by its file in src/content/articles/:
// both editions of the design's article page (Article.astro).
import { getCollection } from 'astro:content';
import Journal from '../../layouts/Journal.astro';
import Article from '../../components/Article.astro';
import { articleContent } from '../../components/writing';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({ params: { address: article.id }, props: { article } }));
}

const { article } = Astro.props;
const content = await articleContent(article);
---
<Journal page="article"><Article edition="desktop" article={content} /><Article edition="pocket" article={content} /></Journal>

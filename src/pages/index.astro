import HomeDesktop from '../components/HomeDesktop.astro';
import HomePocket from '../components/HomePocket.astro';
import { homeContent } from '../components/home';

const home = await homeContent();
---
<Journal page="home"><HomeDesktop home={home} /><HomePocket home={home} /></Journal>

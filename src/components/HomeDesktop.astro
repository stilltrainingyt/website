---
// The home page's desktop edition: design-reference/desktop.html's home page as written, with
// its words from src/data/home.yaml and its lists from the content files (home.ts). Each of
// its parts is marked data-edition="desktop", so below 900 px edition.js removes them.
// Published titles on the track cards link to their pages, drawn as the design draws the
// episode log's linked titles (.ttl a); planned ones are plain text.
import { chipClass, counting, type HomeContent } from './home';

interface Props { home: HomeContent }
const { copy, cards, articles, projects, projectCount } = Astro.props.home;
const { cover, premise, tracks, byHand, cabinet } = copy;
---
  <!-- ============ 00 COVER ============ -->
  <div class="stage" data-edition="desktop">
  <section class="leaf gridded" id="cover" data-leaf>
    <span class="washi tl" aria-hidden="true"></span>
    <span class="washi tr" aria-hidden="true"></span>
    <span class="ribbon" aria-hidden="true"></span>
    <span class="pencil" aria-hidden="true"></span>
    <span class="ring" style="right:-40px; bottom:-30px" aria-hidden="true"></span>
    <div class="pair" style="align-items:center">
      <div class="stack">
        <p class="eyebrow">{cover.eyebrow.desktop}</p>
        <h1>{cover.title.map((line, i) => (i === 0 ? line : <Fragment><br>{line}</Fragment>))}</h1>
        <hr class="hr">
        <p class="lede">{cover.lede.desktop}</p>
        <div class="btnrow">
          <a class="btn" href="#tracks" data-go="tracks"><span class="lbl">{cover.syllabus}</span><span class="arrow">&#8594;</span></a>
          <a class="btn ghost" href="/episodes/" data-route="episodes"><span class="lbl">{cover.episodes}</span><span class="arrow">&#8595;</span></a>
        </div>
        <div style="display:flex; flex-wrap:wrap; gap:10px; padding-top:6px">
          {cards.map((card) => <span class={chipClass(card.look)}>{card.title}</span>)}
        </div>
      </div>
      <div class="echowrap" id="echoWrap"><button class="echobtn" id="echoBtn" type="button" aria-label="Send Echo round for one more episode">
        <img class="echo lt" id="echoLt" alt="" src="/images/echo-light.png" width="460" height="325">
        <img class="echo dk" id="echoDk" alt="" src="/images/echo-dark.png" width="460" height="325">
      </button>
        <p class="chip" id="epCount" role="status">Episode 001</p>
        <p class="hand">{cover.echo}</p>
      </div>
    </div>
  </section>
  </div>

  <!-- ============ 01 PREMISE ============ -->
  <div class="stage" data-edition="desktop">
  <section class="leaf ruled punched" id="premise" data-leaf>
    <span class="holes" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span>
    <span class="clipart" aria-hidden="true">
      <svg viewBox="0 0 40 88" width="40" height="88" aria-hidden="true">
        <path d="M20 84 V22 a10 10 0 0 1 20 0 v48 a16 16 0 0 1-32 0 V18 a14 14 0 0 1 28 0 v52"
          fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" style="color:var(--clip)"></path>
      </svg>
    </span>
    <div class="pair">
      <div class="stack">
        <p class="eyebrow">{premise.eyebrow.desktop}</p>
        <h2>{premise.title}</h2>
        <p>{premise.intro.desktop}</p>
        <p>{premise.pad.intro}</p>
        <div>
          <div class="padtop" aria-hidden="true"></div>
          <div class="pad" id="pad">
            {premise.pad.pages.map((page) => <div class="pg"><span class="k">{page.title}</span><p>{page.text.desktop}</p></div>)}
          </div>
        </div>
        <div class="row-ctl">
          <button class="mini" id="pgBack" type="button" disabled>Turn back</button>
          <button class="btn" id="pgNext" type="button"><span class="lbl">Turn the page</span><span class="arrow">&#8593;</span></button>
          <span class="count" id="pgNum" role="status">{`Page 1 of ${premise.pad.pages.length}`}</span>
        </div>
        <hr class="hr thin">
        <div class="spec">
          {premise.spec.map((row, i) => <div class="row" style={i === premise.spec.length - 1 ? 'border-bottom:0' : undefined}><span class="k">{row.label}</span><span class="v">{row.text}</span></div>)}
        </div>
      </div>
      <div class="stack" style="gap:26px">
        <div class="note" data-drag tabindex="0" role="group" aria-label="Loose sticky note. Move it with the arrow keys.">
          <p class="hand">{premise.note.map((line, i) => (i === 0 ? line : <Fragment><br>{line}</Fragment>))}</p>
        </div>
        <div class="scrapwrap" data-drag tabindex="0" role="group" aria-label="Loose scrap of paper. Move it with the arrow keys."><div class="scrap">
          <p class="eyebrow" style="margin-bottom:8px">{premise.scrap.title}</p>
          <p style="font-family:var(--mono); font-size:13.5px; line-height:1.75; color:var(--ink-2)">
            {premise.scrap.lines.map((line, i) => <Fragment>{i > 0 && <br>}{`${line.label}  ${line.value}`}</Fragment>)}
          </p>
        </div></div>
        <p class="hand" style="padding-left:6px">{premise.aside.map((line, i) => (i === 0 ? line : <Fragment><br>{`   ${line}`}</Fragment>))}</p>
      </div>
    </div>
  </section>
  </div>

  <!-- ============ 02 TRACKS ============ -->
  <div class="stage" data-edition="desktop">
  <section class="leaf" id="tracks" data-leaf>
    <span class="washi bl" aria-hidden="true"></span>
    <div class="stack">
      <p class="eyebrow">{tracks.eyebrow.desktop}</p>
      <h2>{tracks.title}</h2>
      <p class="lede">{tracks.lede.desktop}</p>
      <div class="deck" id="deck">
        {cards.map((card) => (
        <article class="flipcard" data-tilt>
          <div class="flipin">
            <div class="card front">
              <p class="num">{card.number}</p>
              <h3>{card.title}</h3>
              <p style="color:var(--ink-2); font-size:15.5px">{card.about}</p>
              <ul>
                {card.items.map((item) => (item.href ? <li class="ttl"><a href={item.href}>{item.title}</a></li> : <li>{item.title}</li>))}
              </ul>
              <div class="foot"><span class={chipClass(card.look)}>{card.chip}</span><button class="mini" type="button" data-flip>Turn over</button></div>
            </div>
            <div class="card back">
              <p class="num">{card.backNumber.desktop}</p>
              <h3>{tracks.back}</h3>
              <ul>
                {card.outcomes.map((outcome) => <li>{outcome}</li>)}
              </ul>
              <div class="foot"><span class="hand">{card.needs}</span><button class="mini" type="button" data-flip>Turn back</button></div>
            </div>
          </div>
        </article>
        ))}
      </div>
    </div>
  </section>
  </div>

  <!-- ============ 03 BY HAND ============ -->
  <div class="stage" data-edition="desktop">
  <section class="leaf gridded" id="byhand" data-leaf>
    <span class="washi tr" aria-hidden="true"></span>
    <div class="stack">
      <p class="eyebrow">{byHand.eyebrow.desktop}</p>
      <h2>{byHand.title}</h2>
      <p class="lede">{byHand.lede.desktop}</p>
      <div class="plot"><canvas id="gd" role="img" aria-label="A bowl-shaped loss curve with a dot marking the current weight. The lowest point is at weight 3."></canvas></div>
      <div class="controls">
        <label class="lrbox" for="lr"><span>Step size &nbsp;<output id="lrOut" for="lr">0.30</output></span>
          <input type="range" id="lr" min="0.05" max="1.1" step="0.05" value="0.3"></label>
        <button class="btn" id="stepBtn" type="button"><span class="lbl">Take one step</span><span class="arrow">&#8600;</span></button>
        <button class="mini" id="resetBtn" type="button">Start over</button>
      </div>
      <p class="gdsay" id="gdSay" role="status">The dot starts at weight 7.50. Each step moves it against the slope.</p>
      <div class="logwrap">
        <table id="gdTable">
          <caption class="skip">Each step of the walk, worked out</caption>
          <thead><tr>
            <th scope="col">Step number</th>
            <th scope="col">Weight before the step</th>
            <th scope="col">Slope of the curve at that weight</th>
            <th scope="col">Step size &times; slope (how far to move)</th>
            <th scope="col">Weight after the step</th>
            <th scope="col">How wrong the model is now</th>
          </tr></thead>
          <tbody id="gdBody"><tr><td colspan="6" style="font-family:var(--body); color:var(--ink-3)">No steps yet. Press &ldquo;Take one step&rdquo; and the working appears here.</td></tr></tbody>
        </table>
      </div>
      <p style="font-family:var(--mono); font-size:12.5px; color:var(--ink-3)">{byHand.hint.desktop}</p>
    </div>
  </section>
  </div>

  <!-- ============ 05 THE CABINET ============ -->
  <div class="stage" data-edition="desktop">
  <section class="leaf" id="files" data-leaf>
    <span class="washi tl" aria-hidden="true"></span>
    <div class="stack">
      <p class="eyebrow">{cabinet.eyebrow.desktop}</p>
      <h2>{cabinet.title}</h2>
      <p class="lede">{cabinet.lede.desktop}</p>
      <div class="cabinet">
        <button class="folder a" type="button" aria-expanded="false" aria-controls="drawer-articles">
          <span class="f-back"><span class="f-tab">{cabinet.articles.tab}</span></span>
          <span class="f-paper p1" aria-hidden="true"></span><span class="f-paper p2" aria-hidden="true"></span><span class="f-paper p3" aria-hidden="true"></span>
          <span class="f-front"><span class="f-meta">{counting(cabinet.inside, articles.length)}</span><span class="f-label">{cabinet.articles.label}</span><span class="f-hint">Open</span></span>
        </button>
        <div class="drawer" id="drawer-articles" hidden>
          <div class="drawer-head"><h3>{cabinet.articles.label}</h3><a class="mini" href="/writing/" data-route="writing">{cabinet.articles.all}</a></div>
          <div class="sheets">
            {articles.map((sheet) => <article class="sheet"><h3>{sheet.title}</h3><p>{sheet.summary}</p><div class="tags">{sheet.tags.map((tag) => <span class={chipClass(tag.look)}>{tag.text}</span>)}</div></article>)}
          </div>
        </div>
        <button class="folder b" type="button" aria-expanded="false" aria-controls="drawer-projects">
          <span class="f-back"><span class="f-tab">{cabinet.projects.tab}</span></span>
          <span class="f-paper p1" aria-hidden="true"></span><span class="f-paper p2" aria-hidden="true"></span><span class="f-paper p3" aria-hidden="true"></span>
          <span class="f-front"><span class="f-meta">{counting(cabinet.inside, projects.length)}</span><span class="f-label">{cabinet.projects.label}</span><span class="f-hint">Open</span></span>
        </button>
        <div class="drawer" id="drawer-projects" hidden>
          <div class="drawer-head"><h3>{cabinet.projects.label}</h3><a class="mini" href="/projects/" data-route="projects">{counting(cabinet.projects.all.desktop, projectCount)}</a></div>
          <div class="sheets">
            {projects.map((sheet) => <article class="sheet"><h3>{sheet.title}</h3><p>{sheet.summary}</p><div class="tags">{sheet.tags.map((tag) => <span class={chipClass(tag.look)}>{tag.text}</span>)}</div></article>)}
          </div>
        </div>
      </div>
    </div>
  </section>
  </div>

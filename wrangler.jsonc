// Cloudflare Workers settings: static files only, no Worker script.
{
  "name": "stilltraining",
  "compatibility_date": "2026-10-01",
  // The site answers at stilltraining.stilltraining-ai.workers.dev, and each
  // branch's preview at <branch>-stilltraining.stilltraining-ai.workers.dev.
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    // Unknown addresses get dist/404.html with a 404 status.
    "not_found_handling": "404-page"
  },
  // Lets Cloudflare's preview builds (npx wrangler preview) give each pull request
  // its own preview. Empty: previews use the settings above.
  "previews": {}
}
